bool BaiXe::co_loai(string loai, int& dem, double& tong) const {
	dem = 0; tong = 0;
	if (co1 && pt1.lay_loai_xe() == loai) { 
		++dem; 
		tong += pt1.tinh_phi(); 
	}
	if (co2 && pt2.lay_loai_xe() == loai) { 
		++dem; 
		tong += pt2.tinh_phi(); 
	}
	if (co3 && pt3.lay_loai_xe() == loai) { 
		++dem; 
		tong += pt3.tinh_phi(); 
	}
	return dem > 0;
}
bool BaiXe::xoa(int ma_xe) {
	if (co1 && pt1.lay_ma_xe() == ma_xe) {
	if (co2) {
		pt1 = pt2;
		if (co3) { 
			pt2 = pt3; 
			co3 = false; 
		}
		else co2 = false;
	}
	else co1 = false;
	return true;
	}
	if (co2 && pt2.lay_ma_xe() == ma_xe) {
		if (co3) { 
			pt2 = pt3; 
			co3 = false;
		}
		else co2 = false;
		return true;
	}
	if (co3 && pt3.lay_ma_xe() == ma_xe) {
		co3 = false;
		return true;
	}
	return false;
}


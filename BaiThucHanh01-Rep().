class PhuongTien {
	private:
		int MaXe;
		string LoaiXe;
		int GioVao;
		int ThoiGianDo;
	public:
		PhuongTien();
		PhuongTien(int ma, string loai, int gio, int tg);
		int LayMaXe() const;
		string LayLoaiXe() const;
		int LayGioVao() const;
    	int LayThoiGianDo() const;
		double TinhPhi() const;
		void HienThi() const;
};
PhuongTien::PhuongTien(){
	MaXe = 0;
	LoaiXe = " ";
	GioVao = 0;
	ThoiGianDo = 0;
}
PhuongTien::PhuongTien(int ma, string loai, int gio, int tg){
	MaXe = ma;
	LoaiXe = loai;
	GioVao = gio;
	ThoiGianDo = tg;
}
int PhuongTien::LayMaXe() const {
	return MaXe;
}
string PhuongTien::LayLoaiXe() const {
	return LoaiXe;
}
int PhuongTien::LayGioVao() const {
    return GioVao;
}

int PhuongTien::LayThoiGianDo() const {
    return ThoiGianDo;
}
double PhuongTien::TinhPhi() const {
	double donGia = 0;
    if (LoaiXe == "Car") {
    	donGia = 6;
	}
    if (LoaiXe == "Motorcycle") {
    	donGia = 4;
	}
    if (LoaiXe == "Bicycle") {
    	donGia = 2;
	}
    bool gioCaoDiem = (GioVao >= 6 && GioVao <= 9) || (GioVao >= 15 && GioVao <= 18);
    double heSo = 0.95;
    if (gioCaoDiem) heSo = 1.3;
    int gioDau = ThoiGianDo;
    int gioSau = 0;
    if (ThoiGianDo > 2) {
        gioDau = 2;
        gioSau = ThoiGianDo - 2;
    }
    phiDoXe = gioDau * donGia * heSo + gioSau * donGia * 0.9;
}
void PhuongTien::HienThi() const {
	cout << "Ma xe: " << MaXe
         << "Loai: " << LoaiXe
         << "Gio vao: " << GioVao
         << "Thoi gian do: " << ThoiGianDo
         << "Phi: " << fixed << setprecision(2) << phiDoXe << endl;
}

class BaiXe{
	private:
		int MaBai;
		char KichThuoc;
		PhuongTien pt1, pt2, pt3;
		bool co1, co2, co3;
	public:
		BaiXe();
		BaiXe(int ma, char kichThuoc);
		int LayMa() const;
		char LayKichThuoc() const;
		bool Them(PhuongTien v);
		bool Xoa(int maXe);
		bool Chua(int maXe) const;
		void HienThi() const;
		bool CoLoai(string loai, int& dem, double& tong) const;
};
BaiXe::BaiXe() {
    MaBai = 0;
    KichThuoc = 'S';
    co1 = false;
    co2 = false;
    co3 = false;
}
BaiXe::BaiXe(int ma, char kichthuoc) {
    MaBai = ma;
    KichThuoc = (char)toupper((unsigned char)kichthuoc);
    co1 = false;
    co2 = false;
    co3 = false;
}
int BaiXe::LayMa() const {
    return MaBai;
}
char BaiXe::LayKichThuoc() const {
    return KichThuoc;
}
bool BaiXe::Them(PhuongTien v) {
	int cap = (KichThuoc == 'S') ? 1 : (KichThuoc == 'M') ? 2 : 3;
	if (cap >= 1 && !co1) { 
		pt1 = v; co1 = true; 
		return true; 
	}
	if (cap >= 2 && !co2) { 
		pt2 = v; co2 = true; 
		return true;
	}
	if (cap >= 3 && !co3) { 
		pt3 = v; co3 = true; 
		return true; 
		}
	return false;
}
